import json
import random
import time
from datetime import datetime
from kafka import KafkaProducer

# Inicializamos el productor de Kafka
producer = KafkaProducer(
    bootstrap_servers=['localhost:9092'],
    value_serializer=lambda v: json.dumps(v).encode('utf-8')
)

TOPIC_NAME = "pib-departamental-stream"

# Listas de datos para la simulación
DEPARTAMENTOS = ["Bogotá D.C.", "Antioquia", "Valle del Cauca", "Cundinamarca", "Atlántico", "Santander"]
SECTORES = ["Agricultura", "Industria Manufacturera", "Comercio y Servicios", "Construcción", "Minería"]
ANIOS = list(range(2015, 2026))

print(f"Publicando eventos en tiempo real hacia Kafka (Topic: {TOPIC_NAME})...")

try:
    while True:
        pib_event = {
            "id_reporte": f"REP-{random.randint(100000, 999999)}",
            "anio": random.choice(ANIOS),
            "departamento": random.choice(DEPARTAMENTOS),
            "sector": random.choice(SECTORES),
            "valor_pib": round(random.uniform(500.0, 15000.0), 2),
            "timestamp": datetime.now().strftime("%Y-%m-%d %H:%M:%S")
        }

        producer.send(TOPIC_NAME, value=pib_event)
        print(f"[NUEVO REPORTE] {pib_event['timestamp']} | {pib_event['departamento']} | {pib_event['sector']} | ${pib_event['valor_pib']:,.2f} MM COP")
        time.sleep(random.uniform(0.3, 0.9))
except KeyboardInterrupt:
    print("\nSimulación de transmisión finalizada.")
